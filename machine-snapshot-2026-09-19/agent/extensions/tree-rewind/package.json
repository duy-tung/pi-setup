{
  "name": "pi-tree-rewind",
  "version": "0.4.2",
  "description": "Worktree checkpoints for Pi backed by shadow git repos: rewind code and/or conversation from any node in the session tree. Not the project's own git.",
  "license": "MIT",
  "author": "duytung160596",
  "type": "module",
  "private": true,
  "files": [
    "src/",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:backend && npm run test:preimages && npm run test:recovery-storage && npm run test:retention && npm run test:recovery && npm run test:operations && npm run test:review && npm run test:review-fixes && npm run test:ux && npm run test:line-stats && npm run test:targets",
    "test:backend": "HOME=$(mktemp -d) node --import ./spike/register.mjs spike/backend-test.mts",
    "test:preimages": "HOME=$(mktemp -d) node --import ./spike/register.mjs spike/preimage-test.mts",
    "test:recovery-storage": "HOME=$(mktemp -d) node --import ./spike/register.mjs spike/recovery-storage-test.mts",
    "test:retention": "HOME=$(mktemp -d) node --import ./spike/register.mjs spike/retention-test.mts",
    "test:recovery": "HOME=$(mktemp -d) node --import ./spike/register.mjs spike/recovery-test.mts",
    "test:review": "HOME=$(mktemp -d) node --import ./spike/register.mjs spike/review-regression-test.mts",
    "test:operations": "HOME=$(mktemp -d) node --import ./spike/register.mjs spike/operations-test.mts",
    "test:ux": "node --import ./spike/register.mjs spike/ux-contract-test.mts",
    "test:line-stats": "node --import ./spike/register.mjs spike/line-stats-test.mts",
    "test:targets": "node --import ./spike/register.mjs spike/target-safety-test.mts",
    "test:hazards": "bash spike/hazards.sh && bash spike/hazards2.sh",
    "bench": "HOME=$(mktemp -d) node --import ./spike/register.mjs spike/perf-test.mts",
    "spike": "node spike/shadow-git-spike.mjs",
    "test:review-fixes": "HOME=$(mktemp -d) node --import ./spike/register.mjs spike/review-fixes-test.mts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  }
}
