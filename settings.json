{
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "anthropic/claude-fable-5-1": "medium",
    "openai-codex/gpt-6-astra": "high"
  },
  "showCacheMissNotices": true,
  "theme": "catppuccin-mocha",
  "externalEditor": "nvim",
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "auto",
  "autocompleteMaxVisible": 10,
  "defaultProjectTrust": "ask",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "enableInstallTelemetry": false,
  "npmCommand": [
    "mise",
    "--no-config",
    "exec",
    "node@24.15.0",
    "--",
    "npm"
  ],
  "enabledModels": [
    "anthropic/claude-fable-5-1",
    "openai-codex/gpt-6-astra"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "lastChangelogVersion": "0.85.1",
  "defaultModel": "gpt-6-astra",
  "packages": [
    "git:github.com/duy-tung/pi-anthropic-oauth-plus@v0.3.2",
    "npm:pi-web-search@1.4.0",
    "npm:@upstash/context7-pi@0.1.2",
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0",
    "npm:@juicesharp/rpiv-todo@2.9.0",
    "npm:@tintinweb/pi-subagents@0.19.0",
    "npm:pi-zentui@0.22.3",
    "npm:@juicesharp/rpiv-advisor@2.9.0",
    {
      "source": "npm:pi-background-tasks@2.5.0",
      "extensions": [
        "extensions/background-tasks.ts"
      ]
    },
    "npm:@firstpick/pi-themes-bundle@0.1.6"
  ]
}
